// ScalaHDL — Scala 3 HDL targeting Verilog-2001.
// See hdl-spec.md for the requirements contract. Layout in README.md.

ThisBuild / scalaVersion := "3.3.8"
ThisBuild / organization := "scalahdl"
ThisBuild / version      := "0.1.2"

// SemanticDB paths are relative to a source root, and sbt names only the
// output directory. Without this, the compiler takes the source root from the
// working directory, so a run started outside this directory cannot
// relativise these sources and writes a `.semanticdb` file beside every
// `.scala` under src/. Naming the root keeps the index under target/.
ThisBuild / scalacOptions ++= Seq(
  "-sourceroot",
  (ThisBuild / baseDirectory).value.getAbsolutePath
)

// Two subprojects: the library proper, and examples that depend on it.
// Examples are kept out of any published artifact (R20/contract clarity).

lazy val core = (project in file("core"))
  .settings(
    name := "scalahdl-core",
    // Publication metadata — only the library proper is published (A1/A2).
    licenses        := Seq("Apache-2.0" -> url("https://www.apache.org/licenses/LICENSE-2.0")),
    homepage        := Some(url("https://github.com/Felukov/ScalaHDL")),
    scmInfo         := Some(ScmInfo(
      url("https://github.com/Felukov/ScalaHDL"),
      "scm:git:git@github.com:Felukov/ScalaHDL.git")),
    developers      := List(Developer(
      "Felukov", "Konstantin Felukov", "felukov@gmail.com",
      url("https://github.com/Felukov"))),
    versionScheme   := Some("early-semver"),
    Compile / sourceGenerators += Def.task {
      val output = (Compile / sourceManaged).value / "scalahdl" / "BuildInfo.scala"
      IO.write(output,
        s"""package scalahdl
           |
           |/** Build metadata generated by sbt. */
           |private[scalahdl] object BuildInfo:
           |  val version: String = "${version.value}"
           |""".stripMargin)
      Seq(output)
    }.taskValue,
    libraryDependencies ++= Seq(
      // Scala 3 stdlib covers R1 (inline def + Symbol.spliceOwner) with no plugin.
      "org.scalameta" %% "munit" % "1.0.0" % Test
    ),
    scalacOptions ++= Seq(
      "-deprecation",
      "-feature",
      "-unchecked",
      "-explain",     // R19 spirit: compiler diagnostics should be teaching surface too
      "-language:implicitConversions"  // the DslSignal → Expr conversion is the one deliberate one
    )
  )

lazy val examples = (project in file("examples"))
  .dependsOn(core)
  .settings(
    name := "scalahdl-examples",
    publish / skip := true,
    libraryDependencies ++= Seq(
      "org.scalameta" %% "munit" % "1.0.0" % Test
    ),
    // The examples are a consumer of the library and compile like one: the
    // R21 operator surface is reached through the DSL's one deliberate
    // implicit conversion (`DslSignal → Expr`), which Scala 3 treats as a
    // feature use at every call site that writes `a + b`.
    scalacOptions ++= Seq(
      "-deprecation",
      "-feature",
      "-unchecked",
      "-language:implicitConversions"
    )
  )

lazy val root = (project in file("."))
  .aggregate(core, examples)
  .settings(
    publish / skip := true
  )
